{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsl.local/sentence_predictions.schema.json",
  "title": "VSL Sentence Predictions",
  "type": "object",
  "required": ["version", "predictions"],
  "properties": {
    "version": { "type": "string" },
    "model_name": { "type": "string" },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sample_id", "pred_sentence_text", "pred_sentence_gloss", "pred_segments"],
        "properties": {
          "sample_id": { "type": "string" },
          "pred_sentence_text": { "type": "string" },
          "pred_sentence_gloss": {
            "type": "array",
            "items": { "type": "string" }
          },
          "pred_segments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["gloss", "start_ms", "end_ms"],
              "properties": {
                "gloss": { "type": "string" },
                "start_ms": { "type": "number", "minimum": 0 },
                "end_ms": { "type": "number", "minimum": 0 }
              }
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
