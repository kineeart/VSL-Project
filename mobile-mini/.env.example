# Public backend host for release builds (no localhost)
# Supported forms:
# EXPO_PUBLIC_BACKEND_HOST=192.168.1.10:8000
# EXPO_PUBLIC_BACKEND_HOST=http://192.168.1.10:8000
# EXPO_PUBLIC_BACKEND_HOST=https://api.your-domain.com
EXPO_PUBLIC_BACKEND_HOST=https://api.your-domain.com

# true: lock host input in app UI, false: editable in app
EXPO_PUBLIC_LOCK_BACKEND_HOST=true
